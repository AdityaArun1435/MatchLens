# Copy to .env.local (repo root, for scripts/run_refresh.py) and to web/.env.local (for `npm run dev`).
# Never commit real values. On Vercel, set the same names in Project Settings > Environment Variables.

# Supabase project (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key. Read-only through row-level security. Used by the Next.js pages.
SUPABASE_ANON_KEY=
# Secret/service key. Server only, bypasses row-level security. Used by the refresh function. Do not expose.
SUPABASE_SERVICE_KEY=

# Data sources (see docs/data_sources.md)
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_KEY=

# Shared secret that pg_cron sends to /api/refresh. Any long random string.
CRON_SECRET=

# Optional
# TRACKED_COMPETITIONS=PL,PD,SA,BL1,FL1,CL,DED,PPL,ELC
# AF_DAILY_LIMIT=95
# LIVE_MIN_INTERVAL_S=240

# Classic matches only (the local FastAPI backend)
# NEXT_PUBLIC_API_URL=http://localhost:8000
